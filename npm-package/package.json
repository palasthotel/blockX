{
  "name": "@palasthotel/blockx",
  "version": "1.10.0",
  "description": "React editor views and custom editor widgets for BlockX Gutenberg blocks.",
  "license": "GPL-3.0-or-later",
  "main": "./dist/lib.cjs",
  "module": "./dist/lib.mjs",
  "types": "./dist/lib.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/lib.d.mts",
        "default": "./dist/lib.mjs"
      },
      "require": {
        "types": "./dist/lib.d.cts",
        "default": "./dist/lib.cjs"
      }
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/palasthotel/blockX"
  },
  "author": "Palasthotel <rezeption@palasthotel.de>",
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "react": "^18.2.0",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "unrun": "^0.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
