{
  "name": "@palasthotel/blockx",
  "version": "1.10.1",
  "description": "React editor views and custom editor widgets for BlockX Gutenberg blocks.",
  "license": "GPL-3.0-or-later",
  "main": "./dist/lib.js",
  "module": "./dist/lib.mjs",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "require": "./dist/lib.js",
      "import": "./dist/lib.mjs"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsup src/lib.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/palasthotel/blockX"
  },
  "author": "Palasthotel <rezeption@palasthotel.de>",
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "react": "^18.2.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.2"
  },
  "engines": {
    "node": ">=22"
  }
}
